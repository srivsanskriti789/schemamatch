# SchemeMatch Environment Configuration
ENV=development
PORT=3000

# Backend FastAPI & Database
DATABASE_URL=mysql+pymysql://app_user:change_me@localhost:3306/schemematch
DATABASE_READONLY_URL=mysql+pymysql://app_ro:change_me@localhost:3306/schemematch
SECRET_KEY=change_me_to_a_long_random_secret_key_at_least_32_chars
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# AI / Mitra Assistant
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-1.5-flash

# Security & Feature Flags
OFFICIAL_DOMAIN_ALLOWLIST=gov.in,nic.in
SHOW_SOCIAL_PROOF=true
RATE_LIMIT_PER_MINUTE=30
